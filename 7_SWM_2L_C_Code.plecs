        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h> // Math functions\n"
"\n"
"// Inputs\n"
"#define Va InputSignal(0,0)\n"
"#define Vb InputSignal(1,0)\n"
"#define Vc InputSignal(2,0)\n"
"\n"
"// Variables\n"
"double pi = 3.14159265359;\n"
"/// Inputs\n"
"double Va1 = 0;\n"
"double Vb1 = 0;\n"
"double Vc1 = 0;\n"
"/// Clark Transform\n"
"double Vref_alpha = 0;\n"
"double Vref_beta = 0;\n"
"double Valphabeta_mod = 0; // Vab_mod indicates the magnitud of the reference"
" vector.\n"
"/// Sector\n"
"int sector = 0;\n"
"double v_theta = 0;\n"
"/// Matrix Definition // Son los valores de alpha y beta de las combinaciones"
" pero calculados con (1 0 0) en vez de (1 -1 -1) por ejemplo\n"
"double V[8][2]={ {0,0},\n"
"{2.0/3*1.0,0},\n"
"{2.0/3*0.5,2.0/3*0.866025403784439},\n"
"{-2.0/3*0.5,2.0/3*0.866025403784439},\n"
"{-2.0/3*1,0},\n"
"{-2.0/3*0.5,-2.0/3*0.866025403784439},\n"
"{2.0/3*0.5,-2.0/3*0.866025403784439},\n"
"{0,0}};\n"
"//Variables used for Time Calculation Method 1\n"
"double t0;\n"
"double t1;\n"
"double t2;\n"
"double test;\n"
"\n"
"// Functions\n"
"\n"
"/// Calculates the sector where the reference vector lies\n"
"void An_Sec(double V_alpha, double V_beta ){ // Determina el sector segun el "
"angulo entre alpha y beta para ver dentro de que sector de 60 grados se ubica"
"\n"
" v_theta = atan2(V_beta,V_alpha); // Angle\n"
" // Sector Calculation\n"
" if(v_theta<0)\n"
"    {v_theta=v_theta+2*pi;} /// Hace angulo positivo\n"
"    sector=(int)floor((v_theta+pi/3)*3.0/pi);\n"
"    if(sector==7)\n"
"    {sector=1;}\n"
"}\n"
"\n"
"/// Calculates the time for each Vector that form the selected sector\n"
"void time_calc(double V_alpha, double V_beta){\n"
" double DET_INV;\n"
" //Time calculation\n"
"    if (sector!=6){ // Resuelve la matriz donde la multiplicacion de los tiem"
"pos por los alpha y beta de los 2 vectores adyacientes por los tiempos dan es"
"e alpha y beta segun el sector\n"
"        DET_INV=1/(V[sector][0]*V[sector+1][1]-V[sector+1][0]*V[sector][1]); "
" // Determ = [a * d - b * c]\n"
"        t1=DET_INV*(V_alpha*V[sector+1][1]-V_beta*V[sector+1][0]); // A * [t1"
" t2]' = [Valpha Vbeta] --> [t1 t2]' = A^-1 * [Valpha Vbeta] , donde A = [V1al"
"pha V2alpha ; V1beta V2beta]; A^-1 = 1/(determ) * [d -b ; -c a]\n"
"        t2=DET_INV*(-V_alpha*V[sector][1]+V_beta*V[sector][0]);\n"
"        t0=1-t1-t2; // Dado que es vector nulo, no afecta en el calculo del v"
"alor, por lo que simplemente es T = 1 - el tiempo de los 2\n"
"        test=DET_INV;\n"
"    }\n"
"    else{  \n"
"        DET_INV=1/(V[sector][0]*V[1][1]-V[1][0]*V[sector][1]); // Caso transi"
"cion entre 6 y 1\n"
"        t1=DET_INV*(V_alpha*V[1][1]-V_beta*V[1][0]);\n"
"        t2=DET_INV*(-V_alpha*V[sector][1]+V_beta*V[sector][0]);\n"
"        t0=1-t1-t2; \n"
"        test=DET_INV;\n"
"    }\n"
"}\n"
"\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "OutputSignal(0,0) = sector;\n"
"OutputSignal(1,0) = v_theta;\n"
"OutputSignal(2,0) = t0;\n"
"OutputSignal(3,0) = t1;\n"
"OutputSignal(4,0) = t2;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "// Update Input\n"
"Va1 = Va;\n"
"Vb1 = Vb;\n"
"Vc1 = Vc;\n"
"\n"
"// Clark Transform\n"
"Vref_alpha = 2.0 / 3.0 *(Va1 - Vb1 * 0.5 - Vc1 * 0.5);\n"
"Vref_beta = 2.0 / 3.0 *(Vb1 * sqrt(3)/2 - Vc1 * sqrt(3)/2);\n"
"Valphabeta_mod = sqrt(Vref_alpha * Vref_alpha + Vref_beta * Vref_beta);\n"
"\n"
"// Calculate Sector\n"
"An_Sec(Vref_alpha,Vref_beta);\n"
"\n"
"// Calculate Time\n"
"time_calc(Vref_alpha,Vref_beta);\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
