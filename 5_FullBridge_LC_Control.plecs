  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-5"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-5"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "2"
  DatatypeInheritanceConflictMsg "1"
  ContSampleTimeConflictMsg "1"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\nfs=10000;\nTs = 1/fs "
"; \n\n% DC Voltage\nVdc = 320 ;\n\n\n% Sinusoidal reference\n%Magnitude peak "
"is 220*sqrt(2)=311. Which is lower to the dc-link 320V.\nVpeak = 220*sqrt(2) "
";\nfreq = 50 ;\n\n% Modulation Indexes\n%ma = Vmod/(Vdc/2) ; \nmf = fs/freq; "
"\n\n% Carrier \nVcr = Vdc/2;\nfcr = mf*freq ;\n\n\n% Planta iL\nL = 1e-3 ; \n"
"RL = 1e-3 ; \n\n% Planta Vdc\nC = 160e-6 ; \nRc = 10e-3 ; \n\nR_load = Vpeak/"
"16 /sqrt(2) ; \n\n% Controlador iL\nwn_iL = 2*pi*500 ; \nxi_iL = 0.707 ; \nKp"
"_iL = 2*xi_iL*wn_iL*L - RL ; \nKi_iL = (wn_iL*wn_iL)*L ; \n\n\n% Controlador "
"Vdc\nwn_vdc = 2*pi*20; \nxi_vdc = 0.707 ; \nKp_vdc = 2*xi_vdc*wn_vdc*C ; \nKi"
"_vdc = (wn_vdc*wn_vdc)*C ; \n\n\n% Frecuencia de resonancia filtro LC\nf_LC ="
" 1 / ( 2*pi*sqrt(L*C) ) ; \n% Se recomienda entre 5 y 10 veces la frecuencia "
"fundamental, tipico: 8\n\n\n\n\n\n\n"
